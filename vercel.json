{
  "buildCommand": "node scripts/minify.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/siechem-redesign.html" },
    { "source": "/admin", "destination": "/admin/admin-login.html" },
    { "source": "/admin/", "destination": "/admin/admin-login.html" },
    { "source": "/admin/dashboard", "destination": "/admin/admin.html" },
    { "source": "/admin/family", "destination": "/admin/admin-family.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/catalog/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(theme\\.css|animations\\.js|nav-mobile\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "redirects": [

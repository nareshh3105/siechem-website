ylene (CSPE) ü Traceable ü Flame retardant ü Radiation stability ISO ISO IATF AS ISO ü Long term moisture 9001 14001 16949 14001 45001 ü Long term thermal enduarance ü Stripping for ease of termination ü Radiation resistant up to 200 megarads — Part Number","No.of Pairs/ No.of Triads","Cond. Size (AWG)","No.of Strands/ Strand dia","Insulation Thickness (Nom.) — mm","Outer Sheath Thickness — mm","Cable Diameter (Nom.) — mm","Cable Weight (approx.) — kg/km"],"rows":[["95781XX","2P","18","7/0.386","0.64","1.14","11.7","192"],["95781XX","3P","18","7/0.386","0.64","1.14","12.5","237"],["95781XX","4P","18","7/0.386","0.64","1.52","14.4","336"],["95781XX","5P","18","7/0.386","0.64","1.52","15.7","397"],["95781XX","7P","18","7/0.386","0.64","1.52","17.1","433"],["95781XX","9P","18","7/0.386","0.64","1.52","19.9","539"],["95781XX","12P","18","7/0.386","0.64","2.03","23.4","744"],["95781XX","19P","18","7/0.386","0.64","2.03","27.4","988"],["95780XX","2P","16","7/0.488","0.64","1.14","12.6","247"],["95780XX","3P","16","7/0.488","0.64","1.52","14.1","330"],["95780XX","4P","16","7/0.488","0.64","1.52","15.4","423"],["95780XX","5P","16","7/0.488","0.64","1.52","16.9","509"],["95780XX","7P","16","7/0.488","0.64","1.52","18.4","560"],["95780XX","9P","16","7/0.488","0.64","2.03","22.5","769"],["95780XX","12P","16","7/0.488","0.64","2.03","25.3","969"],["95780XX","19P","16","7/0.488","0.64","2.03","29.6","1313"],["95881XX","2T","18","7/0.386","0.64","1.14","12.4","256"],["95881XX","3T","18","7/0.386","0.64","1.14","13.2","320"],["95881XX","4T","18","7/0.386","0.64","1.52","15.2","458"],["95881XX","5T","18","7/0.386","0.64","1.52","16.6","542"],["95881XX","7T","18","7/0.386","0.64","1.52","18.1","595"],["95881XX","9T","18","7/0.386","0.64","1.52","21.2","734"],["95881XX","12T","18","7/0.386","0.64","2.03","24.9","1019"],["95881XX","19T","18","7/0.386","0.64","2.03","29.1","1354"],["95880XX","2T","16","7/0.488","0.64","1.52","14.1","332"],["95880XX","3T","16","7/0.488","0.64","1.52","1